# music-restoration personal config
#
# Copy to ~/.config/music-restoration/config.env (install.sh does this) and edit.
# Every key is optional: anything you leave out is auto-detected or defaulted.
# Environment variables of the same name override this file.

# Local music library (default source of albums, used for lyric transplant)
#MUSIC_DIR=/home/YOU/Music

# Phone music root over MTP (gvfs mount).
# Leave unset to auto-detect: the first gvfs mtp mount containing a Music dir.
# Example:
#PHONE_DIR=/run/user/1000/gvfs/mtp:host=SAMSUNG_SAMSUNG_Android_XXXX/Внутреннее хранилище/Music

# gio URI base matching PHONE_DIR (auto-derived from the mount when unset).
#MTP_BASE=mtp://SAMSUNG_SAMSUNG_Android_XXXX/Внутреннее хранилище/Music

# State files (TSV inventories, DR scans, caches). Default: ~/.local/state/music-restoration
#STATE_DIR=

# Working directory for staging/restoring (needs several GB free). Default: STATE_DIR/work
#WORK_DIR=
