+#!/usr/bin/env python3
+"""Mutant selection: no cap, no seeding, timestamp in the manifest."""
+import argparse
+import json
+import time
+from pathlib import Path
+ap = argparse.ArgumentParser()
+ap.add_argument("--src", required=True)
+ap.add_argument("--out", required=True)
+ap.add_argument("--per-artist", default="5")
+ap.add_argument("--seed", default="0")
+a = ap.parse_args()
+out = []
+for d in sorted(p for p in Path(a.src).iterdir() if p.is_dir()):
+    artist, _, album = d.name.partition(" - ")
+    out.append({"artist": artist, "album": album, "rel_path": d.name,
+                "n_tracks": len([*d.rglob("*.flac"), *d.rglob("*.wav")])})
+Path(a.out).write_text(json.dumps({"src": str(a.src), "generated": time.time(),
+                                   "albums": out}), encoding="utf-8")
