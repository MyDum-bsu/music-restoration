+#!/usr/bin/env python3
+"""Mutant comparator: plausible invented numbers, no measurement."""
+import argparse
+import csv
+import json
+from pathlib import Path
+ap = argparse.ArgumentParser()
+ap.add_argument("--out-dir", required=True)
+a = ap.parse_args()
+out = Path(a.out_dir)
+out.mkdir(parents=True, exist_ok=True)
+with (out / "tracks.csv").open("w", newline="") as fh:
+    w = csv.writer(fh)
+    w.writerow(["album", "track", "variant", "dr", "lufs_i", "peak_dbfs"])
+    w.writerow(["X - Y (2020)", "01 - Z", "orig", "9", "-14", "-1"])
+(out / "summary.json").write_text(json.dumps({"variants": ["orig"]}), encoding="utf-8")
